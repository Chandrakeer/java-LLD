      "boundElements": null,
      "updated": 1784656545741,
      "link": null,
      "locked": false,
      "text": "Overview\nTic-tac-toe is a simple two-player paper-and-pencil game. Each player selects a piece before\nthe game and takes turns placing it on the 3x3 grid. A player wins by placing three pieces in a\nrow, column, or diagonal. The game ends when a player wins or when all grid cells are filled,\nresulting in a draw.\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Overview\nTic-tac-toe is a simple two-player paper-and-pencil game. Each player selects a piece before\nthe game and takes turns placing it on the 3x3 grid. A player wins by placing three pieces in a\nrow, column, or diagonal. The game ends when a player wins or when all grid cells are filled,\nresulting in a draw.\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
